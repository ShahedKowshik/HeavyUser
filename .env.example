# Public client configuration only. Copy to .env.local for local development.
# Obtain both values from your own Supabase project settings.
# NEVER place service-role or secret API keys in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
